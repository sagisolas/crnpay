{
  "name": "crnpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm build:client && tsx watch --env-file=.env src/server/main.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json && pnpm build:client",
    "build:client": "esbuild src/client/donate.ts src/client/alerts.ts --bundle --minify --format=esm --target=es2022 --loader:.woff2=file --loader:.woff=file --asset-names=fonts/[name]-[hash] --outdir=dist/public",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "cryptocurrency-icons": "^0.18.1",
    "hono": "^4.13.19",
    "intl-messageformat": "^12.2.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
