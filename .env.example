PORT=3000
# Secret part of the Alert page link. Generate with: openssl rand -hex 32
ALERT_KEY=
# Required when EVM Tokens are configured. Free key from https://etherscan.io/apis (works across chains on API V2).
ETHERSCAN_API_KEY=
CONFIG_PATH=./config.json
# Catalog of Token defaults that CONFIG_PATH overrides by Token id. Rarely changed.
DEFAULT_CONFIG_PATH=./config.default.json
DB_PATH=./data/crnpay.db
LOG_LEVEL=info
